{
  "name": "@sandsoftwaresolutions/json-store",
  "version": "0.1.1",
  "description": "A small JSON file store: atomic writes, ordered updates, rollback and versioned migrations. Never overwrites a file it does not understand.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test && node scripts/build-cjs.mjs --check",
    "pack:check": "npm pack --dry-run",
    "build": "node scripts/build-cjs.mjs",
    "prepack": "node scripts/build-cjs.mjs"
  },
  "keywords": [
    "json",
    "store",
    "settings",
    "state",
    "migrations"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SandSoftwareSolutions/ss-json-store.git"
  },
  "bugs": {
    "url": "https://github.com/SandSoftwareSolutions/ss-json-store/issues"
  },
  "homepage": "https://github.com/SandSoftwareSolutions/ss-json-store#readme",
  "publishConfig": {
    "access": "public"
  }
}
